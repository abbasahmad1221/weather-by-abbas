# ─────────────────────────────────────────────────────────────────────────
# Database — PostgreSQL (required)
# ─────────────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Works with any Postgres provider: Neon, Supabase, Railway, RDS, or a
# self-hosted server. Most managed providers also require ?sslmode=require.
DATABASE_URL="postgresql://user:password@host:5432/weather_by_abbas?sslmode=require"

# ─────────────────────────────────────────────────────────────────────────
# NextAuth (required)
# ─────────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# Your site's real base URL in production (no trailing slash)
NEXTAUTH_URL="https://YOUR-DOMAIN.com"

# ─────────────────────────────────────────────────────────────────────────
# Public site URL (required)
# ─────────────────────────────────────────────────────────────────────────
# Used for SEO, canonical URLs, sitemap.xml, robots.txt and OG images.
NEXT_PUBLIC_SITE_URL="https://YOUR-DOMAIN.com"

# ─────────────────────────────────────────────────────────────────────────
# First admin account (required — used once by `npm run seed`)
# ─────────────────────────────────────────────────────────────────────────
# These create your real login the first time you run `npm run seed`.
# Change SEED_ADMIN_PASSWORD to a strong, unique password before deploying —
# never leave the placeholder value below in a production .env.
SEED_ADMIN_EMAIL="admin@YOUR-DOMAIN.com"
SEED_ADMIN_PASSWORD="replace-with-your-own-strong-password"
SEED_ADMIN_NAME="Abbas Nabi"

# ─────────────────────────────────────────────────────────────────────────
# Uploaded weather map storage (optional — defaults to local disk)
# ─────────────────────────────────────────────────────────────────────────
# STORAGE_DRIVER=local (default): files are written to public/uploads on
#   the server's own disk. Only use this if your host gives you a
#   persistent filesystem/volume (e.g. a VPS, or Docker with a mounted
#   volume). Do NOT use "local" on platforms with an ephemeral filesystem
#   (e.g. Vercel) — uploaded images will be lost on every deploy/restart.
#
# STORAGE_DRIVER=s3: files are uploaded to an S3-compatible object store
#   instead (AWS S3, Cloudflare R2, Supabase Storage, MinIO, etc). Required
#   on serverless/ephemeral-filesystem hosts. Uncomment and fill in below.
# STORAGE_DRIVER="s3"
# S3_BUCKET="weather-by-abbas-uploads"
# S3_REGION="auto"
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"   # omit entirely for real AWS S3
# S3_ACCESS_KEY_ID="your-access-key-id"
# S3_SECRET_ACCESS_KEY="your-secret-access-key"
# S3_PUBLIC_URL="https://uploads.YOUR-DOMAIN.com"                # public base URL files are served from

# Set to true only if you intentionally want demo/sample forecasts during seeding.
SEED_INCLUDE_SAMPLES="false"
